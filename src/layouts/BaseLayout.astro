---
import '../styles/global.css';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description = "Autocracia, Tecnologia e Exaustão Cognitiva — Matriz teórica e fichas de leitura por Antonio Coelho.",
  breadcrumbs = []
} = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Prevenção de flash de tema (FOUC) -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('study-theme');
        if (saved) {
          document.documentElement.setAttribute('data-theme', saved);
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body>
    <!-- Acessibilidade: Skip Link -->
    <a href="#main-content" class="skip-to-content">Pular para o conteúdo principal</a>

    <!-- Barra de navegação superior fixa -->
    <header class="site-header">
      <div class="header-inner">
        <nav class="breadcrumbs" aria-label="Navegação estrutural">
          <a href="/" class="brand-link">Autocracia no Século XXI</a>
          {breadcrumbs.map((item) => (
            <>
              <span class="sep" aria-hidden="true">/</span>
              {item.href ? (
                <a href={item.href}>{item.label}</a>
              ) : (
                <span class="current" aria-current="page">{item.label}</span>
              )}
            </>
          ))}
        </nav>

        <div class="header-actions">
          <nav class="main-nav" aria-label="Menu principal">
            <a href="/matriz">Matriz Teórica</a>
            <a href="/obras">Obras</a>
          </nav>
          <button type="button" class="theme-toggle-btn" id="themeToggleBtn" aria-label="Alternar modo visual">
            <span id="themeLabel">Tema</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Conteúdo da página -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Script de alternância de tema -->
    <script>
      const themeToggleBtn = document.getElementById('themeToggleBtn');
      const themeLabel = document.getElementById('themeLabel');
      const htmlEl = document.documentElement;

      function updateLabel(isDark: boolean) {
        if (themeLabel) {
          themeLabel.textContent = isDark ? 'Modo Claro' : 'Modo Escuro';
        }
      }

      const initialIsDark = htmlEl.getAttribute('data-theme') === 'dark';
      updateLabel(initialIsDark);

      themeToggleBtn?.addEventListener('click', () => {
        const current = htmlEl.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        htmlEl.setAttribute('data-theme', next);
        localStorage.setItem('study-theme', next);
        updateLabel(next === 'dark');
      });
    </script>

    <style>
      .site-header {
        border-bottom: 1px solid var(--border);
        background-color: var(--bg-page);
        position: sticky;
        top: 0;
        z-index: 100;
        backdrop-filter: blur(8px);
        background-color: color-mix(in srgb, var(--bg-page) 92%, transparent);
      }

      .header-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 12px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        font-family: var(--font-sans);
        font-size: 0.85rem;
      }

      .breadcrumbs {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--ink-muted);
        overflow-x: auto;
        white-space: nowrap;
      }

      .brand-link {
        font-weight: 600;
        color: var(--ink);
        text-decoration: none;
      }

      .brand-link:hover {
        color: var(--accent);
      }

      .breadcrumbs a {
        color: var(--ink-secondary);
        text-decoration: none;
        transition: color 0.15s;
      }

      .breadcrumbs a:hover {
        color: var(--accent);
      }

      .breadcrumbs .sep {
        opacity: 0.5;
      }

      .breadcrumbs .current {
        color: var(--ink);
        font-weight: 500;
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .main-nav {
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .main-nav a {
        color: var(--ink-secondary);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.15s;
      }

      .main-nav a:hover {
        color: var(--accent);
      }

      .theme-toggle-btn {
        background: none;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        padding: 6px 10px;
        color: var(--ink-secondary);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.15s;
      }

      .theme-toggle-btn:hover {
        border-color: var(--ink-muted);
        color: var(--ink);
      }

      @media (max-width: 768px) {
        .header-inner {
          padding: 10px 16px;
        }

        .main-nav {
          display: none;
        }
      }
    </style>
  </body>
</html>
